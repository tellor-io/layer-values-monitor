# ===================================================================
# LAYER VALUES MONITOR ENV CONFIGURATION
# ===================================================================

# === REQUIRED: LAYER NODE CONNECTION ===
URI=localhost:26657
CHAIN_ID=layertest-5

# === REQUIRED: DISPUTE TRANSACTION CONFIGURATION ===
# These can also be passed as positional CLI arguments.
LAYER_BINARY_PATH="/home/<USERNAME>/layerd"
LAYER_KEY_NAME="<KEY_NAME>"
LAYER_KEYRING_BACKEND="test"
LAYER_KEYRING_DIR="/home/<USERNAME>/.layer"

# === REQUIRED FOR ALERTS ===
# DISCORD_WEBHOOK_URL_1 is required when sending Discord alerts.
# DISCORD_WEBHOOK_URL_2 and DISCORD_WEBHOOK_URL_3 are optional mirrors.
DISCORD_WEBHOOK_URL_1=""
DISCORD_WEBHOOK_URL_2=""
DISCORD_WEBHOOK_URL_3=""

# === OPTIONAL: MONITOR IDENTITY ===
# Defaults to "LVM" if unset.
MONITOR_NAME="LVM"

# === OPTIONAL: LOCAL CSV DATA ROTATION ===
# Defaults to 100000 rows if unset.
MAX_TABLE_ROWS=100000

# === OPTIONAL: CATCHUP BEHAVIOR ===
# Defaults to 15 blocks if unset.
MAX_CATCHUP_BLOCKS=15

# === OPTIONAL: WEBSOCKET STALL WATCHDOG ===
# The node's event bus can go silent for an established subscription while the
# socket stays open and pings answer. If NO message (including the per-block
# NewBlock heartbeat) arrives for this many seconds AND the chain height has
# advanced past the last delivered block, the subscription is treated as wedged
# and the socket is force-reconnected (catch-up replays the gap). 0 disables.
# Defaults to 60 seconds if unset.
WS_STALL_TIMEOUT_SECONDS=60

# === OPTIONAL: DISPUTE PAYMENT SOURCE ===
# Accepted truthy values: true, 1, yes. Defaults to false if unset.
PAYFROM_BOND=false

# === OPTIONAL: TRBBRIDGE MONITORING ===
# Required only when monitoring TRBBridge/TRBBridgeV2 query types on a chain with no
# built-in default (see bridge_networks.py). Built-ins, keyed by the Layer CHAIN_ID:
#   tellor-1    -> 0x6ec401744008f4B018Ed9A36f76e6629799Ee50E (TokenBridgeV2) for both, EVM chain 1
#   layertest-5 -> 0x62733e63499a25E35844c91275d4c3bdb159D29d (v1) / 0x55355157703A44f7516FBB831333317E98944e32 (v2), EVM chain 11155111
# Exact match only: layertest-8 and other testnets need the env vars set explicitly.
# These env vars override the built-ins; TRBBRIDGE_CHAIN_ID falls back to 1 on unknown chains.
TRBBRIDGE_CONTRACT_ADDRESS="0x62733e63499a25E35844c91275d4c3bdb159D29d"
TRBBRIDGEV2_CONTRACT_ADDRESS="0x55355157703A44f7516FBB831333317E98944e32"
TRBBRIDGE_CHAIN_ID=11155111

# === OPTIONAL: BRIDGE VERIFICATION LEDGER (two-tier bridge verification) ===
# Tier 1 records a match as good without waiting. A zero-struct or mismatch is left
# unverified; the reconciler re-reads it after BRIDGE_CONFIRM_SECONDS and that confirm
# read decides good or bad. A full RPC outage records unverified. The reconciler re-reads
# every unverified row each cycle FOREVER (no retry cap, no expiry) — only good/bad end
# the loop. It escalates rows still unverified near the 12h dispute deadline.
# Entries 2..N of EVM_RPC_URLS[_<chain>]
# are failover for the hardened reads (provider rotation).
# BRIDGE_LEDGER_PATH defaults to ./data/bridge_ledger.db next to the project.
BRIDGE_LEDGER_PATH="./data/bridge_ledger.db"
# Seconds between reconciler cycles (default 120). The reconciler also runs one cycle at startup.
BRIDGE_RECONCILE_INTERVAL=120
# Delay before the confirm re-read that settles a zero-struct/mismatch first read (default 60).
# A lagging provider can read zero seconds after a deposit lands; this re-read is the guard.
BRIDGE_CONFIRM_SECONDS=60

# === OPTIONAL: EVM RPC ENDPOINTS ===
# EVM_RPC_URLS applies to the EVM chain implied by CHAIN_ID (tellor-1 -> 1,
# layertest-5 -> 11155111). Use comma-separated URLs for primary + failover endpoints.
EVM_RPC_URLS="https://example-rpc.com,https://backup.example-rpc.com"
# Optional per-chain override, wins over the plain var (multi-chain setups only):
# EVM_RPC_URLS_1="https://mainnet.example-rpc.com,https://mainnet-backup.example-rpc.com"
# EVM_RPC_URLS_11155111="https://sepolia.example-rpc.com,https://sepolia-backup.example-rpc.com"

# INFURA_API_KEY is an optional fallback for chain IDs 1 and 11155111.
INFURA_API_KEY=""

# === OPTIONAL: SAGA GUARDIAN ===
# Required only when starting with --enable-saga-guard.
SAGA_RPC_URLS="https://primary-rpc.saga.xyz,https://backup-rpc.saga.xyz"
SAGA_PRIVATE_KEY=""

# Aggregate report power thresholds. Defaults shown below.
SAGA_IMMEDIATE_PAUSE_THRESHOLD=0.66666666666
SAGA_DELAYED_PAUSE_THRESHOLD=0.3333333333

# === LOGGING ===
# Runtime logs are written to stdout for journald. Defaults keep journald operational
# while debug details remain available through local file logs when enabled.
LVM_JOURNAL_LOG_LEVEL=INFO
# Set to true to also save hourly rotating local logs in the project folder.
LVM_ENABLE_FILE_LOGS=false
# Debug file verbosity when file logs are enabled.
LVM_DEBUG_FILE_LOG_LEVEL=DEBUG
# Emit compact normal-operation report summaries at this interval.
LVM_OPERATIONAL_SUMMARY_INTERVAL_SECONDS=300
# When enabled, debug_log.log and terminal_log.log retain 24 hourly backups.
